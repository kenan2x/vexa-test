# Lightweight CPU adapter: forwards audio to vLLM for text, adds Turkish word
# timestamps (MMS forced aligner), returns Vexa JSON. No GPU needed (keeps the
# GPU free for vLLM).
#
# Build context = repo root:
#   docker build -t vexa-qwen-adapter:offline \
#     --build-arg HTTP_PROXY=$PROXY --build-arg HTTPS_PROXY=$PROXY \
#     -f services/qwen-transcription/Dockerfile.adapter .
FROM python:3.10-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ffmpeg libsndfile1 curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# Matched CPU torch+torchaudio. BOTH the MMS aligner (ctc-forced-aligner) and
# Silero VAD import torchaudio; a torch/torchaudio version mismatch throws
# "undefined symbol: aoti_torch_abi_version", and the default PyPI torchaudio is
# CUDA-linked ("libcudart.so.13 missing"). So: pin an exact CPU pair, then CONSTRAIN
# the requirements install so ctc-forced-aligner can't upgrade torch out from under
# torchaudio. --extra-index-url keeps any torch wheel pull on the CPU index.
RUN pip install --no-cache-dir torch==2.4.1 torchaudio==2.4.1 \
        --index-url https://download.pytorch.org/whl/cpu \
    && printf 'torch==2.4.1\ntorchaudio==2.4.1\n' > /tmp/torch-constraints.txt

COPY services/qwen-transcription/requirements.adapter.txt .
RUN pip install --no-cache-dir -c /tmp/torch-constraints.txt \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements.adapter.txt \
    && python -c "import torch, torchaudio; print('torch', torch.__version__, 'torchaudio', torchaudio.__version__); import torchaudio._extension"

# Bake the MMS aligner model for offline runtime
ARG ALIGN_MODEL=MahmoudAshraf/mms-300m-1130-forced-aligner
RUN python -c "from huggingface_hub import snapshot_download as d; d('${ALIGN_MODEL}'); print('aligner baked')"

# Warm/validate Silero VAD (model ships inside the pip pkg → offline at runtime)
RUN python -c "from silero_vad import load_silero_vad; load_silero_vad(); print('vad baked')"

ENV ALIGN_MODEL=${ALIGN_MODEL} \
    ALIGN_DEVICE=cpu \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    DEFAULT_LANG=tr \
    MIN_AUDIO_SEC=1.2 \
    VAD_ENABLED=1 \
    AUDIO_ENHANCE=1

COPY services/qwen-transcription/adapter.py main.py

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8084/health || exit 1

EXPOSE 8084
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8084"]
